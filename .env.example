# Anthropic API-Key für die KI-gestützte Gerichtauswahl. Nur nötig, wenn
# mindestens ein Kind in config.json KEINE bevorzugte_kategorien gesetzt hat
# (siehe config.json.example) – mit fester Kategorie-Präferenz entscheidet
# das Skript rein regelbasiert, ganz ohne KI/API-Key.
ANTHROPIC_API_KEY=

# Bei true wird nur geloggt, welches Gericht gewählt würde – es wird nichts bestellt.
# Vor dem ersten echten Lauf unbedingt auf true lassen und das Log prüfen!
DRY_RUN=true

# Pfad zur Kinder-Konfiguration (siehe config.json.example). Jedes Kind hat
# einen eigenen GFB-Catering-Account – die Zugangsdaten (benutzername/
# passwort) stehen daher NICHT hier, sondern pro Kind in dieser Datei.
KINDER_CONFIG=config.json

# In den Schulferien wird standardmäßig NICHT bestellt (für alle Kinder,
# es wird von einem gemeinsamen Bundesland ausgegangen). Auf false setzen,
# um auch in den Ferien zu bestellen.
NUR_AUSSERHALB_SCHULFERIEN=true
# Bundesland-Kürzel für die Schulferien-Prüfung, siehe schulferien.json
# (aktuell nur BB/Brandenburg gepflegt).
BUNDESLAND=BB
# Pfad zur Schulferien-Datei (Zeiträume + einzelne bewegliche Ferientage
# pro Bundesland). Nur relevant, wenn NUR_AUSSERHALB_SCHULFERIEN=true.
SCHULFERIEN_CONFIG=schulferien.json

# Zufällige Startverzögerung in Sekunden (0 bis zu diesem Wert), damit der
# tägliche Cronjob nicht jeden Tag exakt zur selben Sekunde bei der Seite
# aufschlägt. 0 = deaktiviert (sofort starten).
STARTUP_JITTER_MAX_SECONDS=900

# --- Playwright-Konfiguration ---
# Browser sichtbar statt headless starten, hilfreich zum Debuggen
PLAYWRIGHT_HEADLESS=true
# Aktionen künstlich verlangsamen (ms), z. B. zum Mitverfolgen im sichtbaren Browser
PLAYWRIGHT_SLOWMO_MS=0
# Timeout für einzelne Aktionen (Klick, Fill, ...) in ms
PLAYWRIGHT_ACTION_TIMEOUT_MS=15000
# Timeout für Seitennavigationen in ms
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_LOCALE=de-DE
PLAYWRIGHT_TIMEZONE=Europe/Berlin
PLAYWRIGHT_VIEWPORT_WIDTH=1280
PLAYWRIGHT_VIEWPORT_HEIGHT=900
# Realistischer Desktop-Chrome-User-Agent statt des von Chromium selbst
# gemeldeten (Bot-/Rate-Limit-Erkennung). Nur ändern, wenn es einen
# konkreten Grund dafür gibt.
PLAYWRIGHT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36
# Playwright-Trace aufzeichnen (trace.zip im Datenverzeichnis, mit
# `playwright show-trace trace.zip` auswertbar) – hilfreich zum Debuggen,
# kostet aber etwas Performance/Speicher
PLAYWRIGHT_TRACE=false

# Verzeichnis für Screenshots/Traces/Logs bei Fehlern
DATA_DIR=/data

# --- ntfy.sh-Benachrichtigungen (optional) ---
# Push-Benachrichtigung nach jedem Kind: Erfolg (welche Gerichte an welchen
# Tagen neu bestellt wurden) bzw. Fehlschlag (Kind-Name + Fehlergrund), siehe
# https://ntfy.sh. Leer lassen (Default) = komplett deaktiviert, es ändert
# sich nichts am bisherigen Verhalten.
# Topic für die Benachrichtigungen, z. B. ein selbst gewählter, schwer zu
# erratender String wie "gfb-bestellung-<zufallsstring>" (auf ntfy.sh sind
# unauthentifizierte Topics öffentlich lesbar für jeden, der den Topic-Namen
# kennt!). Zum Empfangen die ntfy-App (Android/iOS) oder https://ntfy.sh/<topic>
# im Browser abonnieren.
NTFY_TOPIC=
# Basis-URL des ntfy-Servers. Default ist der öffentliche Dienst ntfy.sh;
# bei einem eigenen, selbstgehosteten Server (z. B. via Home Assistant Add-on
# oder Docker) hier die eigene URL eintragen.
NTFY_URL=https://ntfy.sh
# Access Token, falls das Topic auf ntfy.sh reserviert und zugriffsgeschützt
# ist (ntfy.sh-Account -> Settings -> Access Tokens) oder der selbstgehostete
# Server Auth verlangt. Für ein öffentliches, unauthentifiziertes Topic leer lassen.
NTFY_TOKEN=

# Optionales ZWEITES Topic (selber Server/Token wie oben) nur für eine kurze
# Lauf-Zusammenfassung, die im Gegensatz zu NTFY_TOPIC IMMER genau einmal pro
# Skriptlauf verschickt wird – auch wenn nichts neu bestellt wurde. Gedacht
# für Automationen/Dashboards (z. B. Home Assistant), die den Zeitpunkt des
# letzten Laufs unabhängig vom Bestellergebnis auswerten wollen, ohne das
# normale NTFY_TOPIC (Push aufs Handy) mit einer täglichen Nachricht zu
# fluten, an dem ohnehin nichts passiert ist. Leer lassen (Default) = keine
# Zusammenfassungs-Nachricht.
NTFY_STATUS_TOPIC=
